        beta_bs, beta_bt, beta_bp, beta_lt, beta_lp, beta_ls, beta_nu, beta_nut, beta_nup, beta_nus, &
        beta_iota, beta_iotap)
    use, intrinsic :: iso_fortran_env, only: dp => real64
    implicit none
    real(dp), intent(in) :: bs, bt, bp, lt, lp, ls, nu, nut, nup, nus, iota, iotap
    real(dp), intent(out) :: beta, beta_bs, beta_bt, beta_bp, beta_lt, beta_lp, beta_ls, beta_nu, &
        beta_nut, beta_nup, beta_nus, beta_iota, beta_iotap
    real(dp) :: t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12, t13

    t1 = lp + iota*nup
    t2 = lt + iota*nut + 1
    t3 = nup + 1
    t4 = -nut*t1 + t2*t3
    t5 = iota*nus
    t6 = iotap*nu
    t7 = ls + t5 + t6
    t8 = nus*t2 - nut*t7
    t9 = -nus*t1 + t7*t3
    t10 = -iota*nut + lp*nut - lt*nup - lt - nup - 1
    t11 = iota*t3 - t1
    t12 = lt + 1
    t13 = -nup*nut + nut*t3
    beta = bs - bp*t8/t4 - bt*t9/t4
    beta_bs = 1
    beta_bt = (ls + t5 + t6 + iotap*nu*nup - lp*nus + ls*nup)/t10
    beta_bp = (nus - iotap*nu*nut - ls*nut + lt*nus)/t10
    beta_lt = -bp*nus/t4 + bp*t3*t8/t4**2 + bt*t3*t9/t4**2
    beta_lp = -bp*nut*t8/t4**2 + bt*nus/t4 - bt*nut*t9/t4**2
    beta_ls = -bp*nut/t10 + (bt + bt*nup)/t10
    beta_nu = bp*iotap*nut/t4 - bt*iotap*t3/t4
    beta_nut = bp*t11*t8/t4**2 - bp*(t5 - t7)/t4 + bt*t11*t9/t4**2
    beta_nup = bp*t12*t8/t4**2 + bt*t12*t9/t4**2 - bt*(ls + t6)/t4
    beta_nus = (bp + bp*lt)/t10 + (bt*iota - bt*lp)/t10
    beta_iota = bp*t13*t8/t4**2 + bt*t13*t9/t4**2 - bt*(-nup*nus + nus*t3)/t4
    beta_iotap = bp*nu*nut/t4 - bt*nu*t3/t4

end subroutine sfl_beta

