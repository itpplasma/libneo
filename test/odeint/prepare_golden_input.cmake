if(NOT INPUT OR NOT OUTPUT OR NOT EXPECTED_SHA256)
    message(FATAL_ERROR "Immutable ODEINT golden input, output and SHA256 are required")
endif()
file(SHA256 "${INPUT}" actual_sha256)
if(NOT actual_sha256 STREQUAL EXPECTED_SHA256)
    message(FATAL_ERROR "Immutable ODEINT golden source SHA256 mismatch")
endif()
get_filename_component(output_directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
configure_file("${INPUT}" "${OUTPUT}" COPYONLY)
